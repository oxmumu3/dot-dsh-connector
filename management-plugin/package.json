{
  "name": "@oxmumu3/dot-dsh-management",
  "version": "0.6.0-preview.21",
  "description": "DSH \u539f\u751f Dot \u8fde\u63a5\u7ba1\u7406\u9875\uff1a\u8bbf\u95ee\u8bb0\u5f55\u3001\u72ec\u7acb\u4efb\u52a1\u4e0e\u8fde\u63a5\u63a7\u5236",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.15",
    "dsh": "0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.4 || 0.2.1-rc.5"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "dependencies": {
    "zod": "4.6.7",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@modelcontextprotocol/sdk": "1.32.1",
    "playwright-core": "1.64.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "files": [
    "index.js",
    "src/",
    "lib/",
    "runtime/",
    "scripts/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "third-party-licenses/",
    "compatibility.json"
  ],
  "author": "\u725b\u6751\u6728\u6728\u5c71",
  "bin": {
    "dot-dsh-setup": "./scripts/setup.mjs",
    "dot-dsh-mcp-managed": "./scripts/mcp-managed.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oxmumu3/dot-dsh-connector.git",
    "directory": "management-plugin"
  },
  "homepage": "https://github.com/oxmumu3/dot-dsh-connector",
  "bugs": {
    "url": "https://github.com/oxmumu3/dot-dsh-connector/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  }
}
